<?xml version="1.0" encoding="UTF-8"?>
<!--
  Abra este arquivo no Google Earth para acompanhar a simulacao.
  Ele recarrega o a.kml (no mesmo diretorio) a cada 1 segundo.
-->
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Folder>
    <name>L-SIM</name>
    <open>1</open>
    <NetworkLink>
      <name>Simulacao (a.kml)</name>
      <refreshVisibility>0</refreshVisibility>
      <flyToView>0</flyToView>
      <Link>
        <href>a.kml</href>
        <refreshMode>onInterval</refreshMode>
        <refreshInterval>1</refreshInterval>
      </Link>
    </NetworkLink>
  </Folder>
</kml>
